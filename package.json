{
  "name": "onepage-hub",
  "version": "0.1.12",
  "private": false,
  "description": "OnePage Agent Remote: DSH host plugin + ASR bridge + LAN discovery",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "lib/",
    "bridge/",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "onepage",
    "agent-remote"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YannFang2002/onepage-hub.git"
  }
}
